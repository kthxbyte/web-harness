{
  "name": "web-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Give coding agents a live browser session: real DOM, computed styles, console, network, screenshots and interaction over the Chrome DevTools Protocol. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.4.0"
  },
  "bin": {
    "webh": "./webh",
    "web-harness": "./webh"
  },
  "exports": {
    ".": "./src/lib/index.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.mjs\"",
    "mcp": "node src/mcp.mjs"
  }
}
